# Database
# For local development with SQLite, use:
# DATABASE_URL="file:./dev.db"
# For production PostgreSQL (Aurora PG), use:
# DATABASE_URL="postgresql://username:password@host:port/database"
DATABASE_URL="file:./dev.db"

# AI Integration
GEMINI_API_KEY="your-gemini-api-key-here"

# AWS DynamoDB Integration (Events & Analytics Cache)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
DYNAMODB_REGION="us-east-1"
DYNAMODB_FORECAST_TABLE="ForecastCache"
DYNAMODB_OPTIMIZATION_TABLE="OptimizationRuns"

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# OAuth Integration Security
INTEGRATION_ENCRYPTION_KEY="your-32-character-encryption-key-here"

# QuickBooks Integration API
QUICKBOOKS_CLIENT_ID="your-quickbooks-client-id-here"
QUICKBOOKS_CLIENT_SECRET="your-quickbooks-client-secret-here"

# Shopify Integration API
SHOPIFY_CLIENT_ID="your-shopify-client-id-here"
SHOPIFY_CLIENT_SECRET="your-shopify-client-secret-here"

# Square POS Integration API
SQUARE_CLIENT_ID="your-square-client-id-here"
SQUARE_CLIENT_SECRET="your-square-client-secret-here"

