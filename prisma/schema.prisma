datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  createdAt  DateTime   @default(now())
  businesses Business[]
}

model Business {
  id                String             @id @default(uuid())
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  industry          String?
  tenantId          String?
  baselineRevenue   Float              @default(180000.0) // Monthly baseline revenue
  baselineMarketing Float              @default(25000.0)  // Monthly baseline marketing
  baselineInventory Float              @default(40000.0)  // Monthly baseline inventory cost
  baselineFixedCosts Float             @default(30000.0)  // Monthly baseline fixed costs
  createdAt         DateTime           @default(now())
  products          Product[]
  employees         Employee[]
  scenarios         Scenario[]
  actionItems       ActionItem[]
  notifications     Notification[]

  // QuickBooks Online Connection Details
  qboCompanyId               String?
  qboAccessToken             String?
  qboRefreshToken            String?
  qboTokenExpiresAt          DateTime?
  qboRefreshTokenExpiresAt   DateTime?

  // Shopify Connection Details
  shopifyStoreDomain         String?
  shopifyAccessToken         String?

  // Square POS Connection Details
  squareLocationId           String?
  squareAccessToken          String?
  squareRefreshToken         String?
  squareTokenExpiresAt       DateTime?
}

model Product {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  price      Float
  cost       Float
  tenantId   String?

  // Sales volume + inventory planning — all optional. When unitsSoldPerMonth
  // is set, this product participates in per-product revenue decomposition
  // (see lib/simulation-engine.ts); otherwise it's excluded, same as before
  // these fields existed. unitsInStock/reorderPoint/leadTimeDays independently
  // gate per-product stockout risk.
  unitsSoldPerMonth Float?
  unitsInStock      Float?
  reorderPoint      Float?
  leadTimeDays      Int?

  scenarioAdjustments ScenarioProductAdjustment[]
}

model Employee {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  role       String
  department String?
  salary     Float
  tenantId   String?
}

model Scenario {
  id                String             @id @default(uuid())
  businessId        String
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  status            String             @default("COMPLETED") // PENDING, COMPLETED, FAILED
  tenantId          String?
  createdAt         DateTime           @default(now())
  
  // Scenario inputs / sliders
  priceIncrease     Float              @default(0.0) // 0-100%
  employeeCount     Int                @default(10)  // total employee count simulated
  marketingBudget   Float              @default(10000.0) // absolute marketing budget simulated
  supplierDelay     String             @default("none")  // none, minor, moderate, severe

  // Optional user-edited elasticity assumptions — override the industry-derived
  // defaults from lib/industry-profiles.ts when set (see lib/simulation-engine.ts).
  priceElasticityOverride     Float?
  marketingElasticityOverride Float?

  // Optional per-role headcount targets, e.g. [{"role":"Barista","count":18}].
  // When set, overrides employeeCount for payroll purposes — each role is
  // costed at its own average salary instead of one blended average across
  // all employees. Free-text JSON (not a join table) because Employee.role is
  // a free-text field, not a FK'd entity.
  roleTargetsJson String?

  simulationResults   SimulationResult[]
  comments            ScenarioComment[]
  productAdjustments  ScenarioProductAdjustment[]
}

// Per-product price override for a scenario. A product with no row here uses
// the scenario's blanket priceIncrease (see lib/simulation-engine.ts). Unlike
// role targets (free-text JSON, since roles aren't a FK'd entity), products
// are real rows that can be deleted — a join table with onDelete: Cascade on
// both sides keeps this from referencing a stale/deleted product.
model ScenarioProductAdjustment {
  id            String   @id @default(uuid())
  scenarioId    String
  scenario      Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceIncrease Float

  @@unique([scenarioId, productId])
}

model ScenarioComment {
  id         String   @id @default(uuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  authorEmail String
  body        String
  createdAt   DateTime @default(now())
}

// Attached to Business, not Scenario: the counterfactual optimizer
// (app/api/scenarios/optimize) that generates these plans is ad-hoc
// goal-seeking against the business's baseline — it never creates or
// references a Scenario row, so there's nothing scenario-shaped to attach to.
model ActionItem {
  id          String    @id @default(uuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    String    // price | headcount | marketing | none
  description String
  status      String    @default("pending") // pending, in_progress, done
  assignee    String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}

// "drift": predicted-vs-actual diverged beyond threshold, created immediately
// when a QuickBooks sync backfills actuals (lib/predicted-vs-actual.ts).
// "reminder": a scenario's 6-month prediction window has lapsed with no sync
// yet to check it against — created by the scheduled cron job
// (app/api/cron/check-stale-predictions), at most once per scenario.
model Notification {
  id         String   @id @default(uuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  scenarioId String?
  type       String // drift | reminder
  severity   String   @default("info") // info | warning
  title      String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model SimulationResult {
  id                String   @id @default(uuid())
  scenarioId        String
  scenario          Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  
  // Simulation outputs
  projectedRevenue  Float
  projectedProfit   Float
  projectedHeadcount Int
  projectedInventoryRisk Float
  
  // Detailed projection metrics (stored as JSON string)
  // For rendering monthly charts: baseline vs projected
  monthlyDataJson   String   // Stores stringified JSON array

  // Backfilled once ~6 months have elapsed since generatedAt (every stored run
  // uses the default 6-month horizon — see lib/predicted-vs-actual.ts) and the
  // business's integrations sync fresh data. Null until then.
  actualRevenue     Float?
  actualProfit      Float?
  actualCapturedAt  DateTime?

  tenantId          String?
  generatedAt       DateTime @default(now())
}

